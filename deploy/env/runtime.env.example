# =============================================================================
# Aivion production/staging runtime.env EXAMPLE
# =============================================================================
# Copy to the server as /opt/aivion/shared/runtime.env (mode 0640, owner deploy).
# NEVER commit a real runtime.env.
#
# Sensitive values are NOT stored here. Compose mounts Docker secrets and sets:
#   DATABASE_URL_FILE, JWT_SECRET_FILE, ENCRYPTION_KEY_FILE,
#   METRICS_AUTH_TOKEN_FILE, REDIS_PASSWORD_FILE,
#   S3_ACCESS_KEY_FILE, S3_SECRET_KEY_FILE, OPENAI_API_KEY_FILE
# Secret source files live under /etc/aivion/secrets/ (see docs/deployment/secrets.md).
# =============================================================================

# --- App ---
APP_ENV=staging
BACKEND_PORT=8081
WORKER_METRICS_PORT=9091

# --- Database (URL via DATABASE_URL_FILE secret) ---
MIGRATIONS_PATH=/app/migrations

# --- Redis (password via REDIS_PASSWORD_FILE secret) ---
REDIS_ADDR=redis:6379
REDIS_DB=0

# --- S3 / MinIO (credentials via secret files; internal Docker DNS) ---
S3_ENDPOINT=minio:9000
S3_BUCKET_RAW=raw-payloads
S3_BUCKET_EXPORTS=exports
S3_BUCKET_ARTIFACTS=artifacts
S3_USE_SSL=false

# --- Auth / sessions (JWT/encryption via secret files) ---
AUTH_COOKIE_NAME=session_token
AUTH_SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=true
AUTH_PUBLIC_REGISTRATION=false

# --- CORS / admin ---
# Shared stack: include both public demo apex and protected staging entry.
CORS_ALLOWED_ORIGINS=https://aivion.pro,https://staging.aivion.pro
ADMIN_EMAILS=oskolkinm@yandex.ru

# --- Metrics (token via METRICS_AUTH_TOKEN_FILE secret) ---
METRICS_ALLOW_UNAUTHENTICATED=false

# --- OpenAI (key via OPENAI_API_KEY_FILE secret only) ---
OPENAI_MODEL=gpt-4.1
AI_PROVIDER_MODE=real
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SECONDS=120
OPENAI_GLOBAL_CONTEXT_TIMEOUT_SECONDS=300
OPENAI_ACTIONS_TIMEOUT_SECONDS=900
AI_MAX_INPUT_TOKENS_PER_REQUEST=120000
AI_MAX_OUTPUT_TOKENS_PER_REQUEST=8192
# AI_HTTPS_PROXY is injected by Compose for backend/worker → http://ai-egress:10809 (Xray HTTP inbound).
# Do not set HTTP_PROXY or HTTPS_PROXY.

# --- Staging / public demo (shared stack; never enable in APP_ENV=production) ---
# STAGING_DEMO_MODE=true
# STAGING_DEMO_SELLER_ACCOUNT_IDS=1
# PUBLIC_DEMO_MODE=true
# PUBLIC_DEMO_USER_EMAIL=demo@example.com
# PUBLIC_DEMO_SELLER_ACCOUNT_ID is informational; allow-list is STAGING_DEMO_SELLER_ACCOUNT_IDS.
# ALLOW_DEV_SEED=1
# OZON_LIVE_CONNECTION_ENABLED=false  # informational; demo sellers bypass live Ozon via STAGING_DEMO_MODE
# UNIFIED_ANALYSIS_USER_TRIGGER_ENABLED=false  # keep user UA triggers off for public demo

# --- Live Seller Review (temporary AI auditor host; token lives only in Caddy, never here) ---
# LIVE_REVIEW_ENABLED=false
# LIVE_REVIEW_ALLOWED_HOST_SUFFIX=.review.aivion.pro
# LIVE_REVIEW_ALLOWED_SELLER_ACCOUNT_ID=1

# --- Worker ---
WORKER_CONCURRENCY=1
WORKER_SCHEDULER_ENABLED=true
SYNC_INTERVAL=5m

# --- Feature flags (staging defaults; tune per release) ---
SELLER_AI_PIPELINE_ENABLED=true
ACTIONS_AI_FIRST=true
AI_PIPELINE_SHARED_CHUNK_ANALYSIS_ENABLED=true
LEGACY_AI_POST_SYNC_ENABLED=false
DASHBOARD_VALIDATION_MODE=pilot_structural
UNIFIED_ANALYSIS_PROVIDER_ENABLED=true
UNIFIED_ANALYSIS_ROLLOUT_ENABLED=true
UNIFIED_ANALYSIS_PROMPT_PROFILE=analysis
UNIFIED_ANALYSIS_LEGACY_FALLBACK_ENABLED=true
