{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "aivion_unified_analysis_v11"
      ]
    },
    "analysis_meta": {
      "$ref": "#/$defs/AnalysisMeta"
    },
    "analysis_outcome": {
      "type": "string",
      "enum": [
        "material_actions_found",
        "no_material_actions",
        "insufficient_data",
        "analysis_failed"
      ]
    },
    "metric_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MetricClaim"
      },
      "maxItems": 60
    },
    "threshold_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ThresholdClaim"
      },
      "maxItems": 20
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 40
    },
    "dashboard": {
      "$ref": "#/$defs/Dashboard"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "maxItems": 15
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Limitation"
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_meta",
    "analysis_outcome",
    "metric_claims",
    "threshold_claims",
    "findings",
    "dashboard",
    "actions",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "AnalysisMeta": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string"
        },
        "pack_hash": {
          "type": "string"
        },
        "metric_date": {
          "type": "string"
        }
      },
      "required": [
        "pack_id",
        "pack_hash",
        "metric_date"
      ],
      "additionalProperties": false
    },
    "MetricClaim": {
      "type": "object",
      "description": "One numeric assertion referencing exactly one current Pack fact (and optionally a previous-period fact for delta rendering).",
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "metric_code": {
          "type": "string"
        },
        "scope_type": {
          "type": "string",
          "enum": [
            "account",
            "funnel",
            "sku",
            "campaign",
            "category"
          ]
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_fact_id": {
          "type": "string"
        },
        "previous_fact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "render_format": {
          "type": "string",
          "enum": [
            "money",
            "integer",
            "percent",
            "days",
            "units",
            "ratio",
            "decimal"
          ]
        },
        "delta_mode": {
          "type": "string",
          "enum": [
            "none",
            "absolute",
            "percent",
            "percentage_points"
          ]
        }
      },
      "required": [
        "claim_id",
        "metric_code",
        "scope_type",
        "entity_id",
        "current_fact_id",
        "previous_fact_id",
        "render_format",
        "delta_mode"
      ],
      "additionalProperties": false
    },
    "ThresholdClaim": {
      "type": "object",
      "description": "A policy-backed comparative threshold cited by a Finding, grounded in the versioned business policy registry. AI must copy policy_id verbatim.",
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "metric_claim_id": {
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "policy_id",
        "metric_claim_id"
      ],
      "additionalProperties": false
    },
    "FindingScope": {
      "type": "object",
      "properties": {
        "scope_type": {
          "type": "string",
          "enum": [
            "account",
            "funnel",
            "sku",
            "campaign",
            "category"
          ]
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "scope_type",
        "entity_ids"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "description": "One atomic analytical finding. Findings are the single source of truth referenced by dashboard blocks and actions via finding_id.",
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "enum": [
            "sales",
            "funnel",
            "stock",
            "advertising",
            "sku",
            "category",
            "data_quality"
          ]
        },
        "finding_type": {
          "type": "string",
          "description": "Closed enum of all finding types produced by Unified Analysis (contract section 11).",
          "enum": [
            "revenue_decline",
            "revenue_growth",
            "orders_decline",
            "orders_growth",
            "average_order_value_decline",
            "average_order_value_growth",
            "sales_stable",
            "traffic_decline",
            "impression_to_view_decline",
            "view_to_cart_decline",
            "cart_to_order_decline",
            "order_to_delivery_decline",
            "funnel_conversion_improved",
            "stockout",
            "critical_coverage",
            "short_coverage",
            "no_sales_with_stock",
            "slow_turnover",
            "surplus",
            "coverage_healthy",
            "high_drr_campaign",
            "spend_without_orders",
            "ad_share_growth",
            "ad_share_decline",
            "campaign_efficiency_improved",
            "budget_concentration",
            "sku_orders_drop",
            "key_sku_stock_risk",
            "key_sku_growth",
            "key_sku_concentration",
            "category_underperformance",
            "category_growth",
            "category_concentration",
            "history_missing",
            "source_incomplete",
            "data_stale"
          ]
        },
        "primary_block": {
          "type": "string",
          "enum": [
            "account",
            "what_changed",
            "category",
            "funnel",
            "stock",
            "advertising",
            "seller_pulse",
            "sku_focus"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "neutral"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "important",
            "watch",
            "none"
          ]
        },
        "interpretation": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "hypothesis"
          ]
        },
        "title": {
          "type": "string"
        },
        "explanation_template": {
          "type": "string"
        },
        "business_impact_template": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/FindingScope"
        },
        "metric_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "threshold_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "limitation_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "finding_id",
        "domain",
        "finding_type",
        "primary_block",
        "direction",
        "severity",
        "interpretation",
        "title",
        "explanation_template",
        "business_impact_template",
        "scope",
        "metric_claim_ids",
        "threshold_claim_ids",
        "confidence",
        "limitation_codes"
      ],
      "additionalProperties": false
    },
    "ImprovementLever": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "explanation_template": {
          "type": "string"
        },
        "finding_id": {
          "type": "string"
        },
        "linked_action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_direction": {
          "type": "string",
          "enum": [
            "risk_decrease",
            "revenue_support",
            "conversion_improvement",
            "cost_efficiency",
            "stock_stability",
            "data_quality_improvement"
