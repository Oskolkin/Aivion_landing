# =========================================
# APP
# =========================================
APP_ENV=local

# =========================================
# SERVER
# =========================================
BACKEND_PORT=8081
FRONTEND_PORT=3000

# =========================================
# DATABASE
# =========================================
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/marketplace_ai?sslmode=disable
MIGRATIONS_PATH=./migrations

# =========================================
# REDIS
# =========================================
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# =========================================
# S3 / MINIO
# =========================================
S3_ENDPOINT=127.0.0.1:19000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET_RAW=raw-payloads
S3_BUCKET_EXPORTS=exports
S3_BUCKET_ARTIFACTS=artifacts
S3_USE_SSL=false

# =========================================
# AUTH
# =========================================
JWT_SECRET=replace-me-local
ENCRYPTION_KEY=REPLACEME_LOCAL_ENC_KEY_32BYTES!

AUTH_COOKIE_NAME=session_token
AUTH_SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
# Public self-service registration. Deployed envs (staging/production) must use false.
# AUTH_PUBLIC_REGISTRATION=false
AUTH_PUBLIC_REGISTRATION=

# Ozon Private Application OAuth used by new canonical collectors.
OZON_OAUTH_CLIENT_ID=
OZON_OAUTH_CLIENT_SECRET=
# Optional test/enterprise override; defaults to https://xapi.ozon.ru.
OZON_OAUTH_TOKEN_BASE_URL=
# Canonical /v1/analytics/data pacing. First request is immediate; default 1m.
OZON_ANALYTICS_MIN_INTERVAL=1m

# =========================================
# CORS / ADMIN
# =========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_EMAILS=

# =========================================
# SENTRY
# =========================================
SENTRY_DSN=
SENTRY_RELEASE=dev

# =========================================
# TELEMETRY
# =========================================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=marketplace-ai-backend

# =========================================
# OPENAI PROVIDER
# =========================================
OPENAI_API_KEY=
# Production/staging: prefer a Docker/secret file mount instead of OPENAI_API_KEY.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
OPENAI_API_KEY_FILE=

OPENAI_MODEL=gpt-4.1
AI_PROVIDER_MODE=real

OPENAI_MAX_RETRIES=0

# General timeout for ordinary AI calls.
OPENAI_TIMEOUT_SECONDS=120

# Fill only in .env.local — never commit real keys.
# AI_PROXY_URL=http://127.0.0.1:10809
AI_PROXY_URL=
AI_HTTPS_PROXY=
# Optional deprecated alias for local tooling only (prefer AI_HTTPS_PROXY):
# AI_PROXY_URL=
# Do not set HTTP_PROXY / HTTPS_PROXY for Aivion — they are ignored by OpenAI clients
# and must not route Ozon or other integrations.

# =========================================
# GLOBAL CONTEXT
# =========================================
OPENAI_GLOBAL_CONTEXT_TIMEOUT_SECONDS=300
OPENAI_GLOBAL_CONTEXT_MAX_OUTPUT_TOKENS=16384

# =========================================
# DASHBOARD
# =========================================
DASHBOARD_VALIDATION_MODE=pilot_structural
DASHBOARD_NARRATIVE_MAX_OUTPUT_TOKENS=12000
DASHBOARD_NARRATIVE_DEBUG=0
DASHBOARD_AI_SUMMARIES_DEBUG=0

# =========================================
# ACTIONS COMPOSE
# =========================================
OPENAI_ACTIONS_TIMEOUT_SECONDS=900
OPENAI_ACTIONS_MAX_OUTPUT_TOKENS=16384

# =========================================
# ACTION OBJECT DETAIL
# =========================================
ACTIONS_OBJECT_DETAIL_BATCH_SIZE=10
ACTIONS_OBJECT_DETAIL_MAX_CONCURRENCY=2
OPENAI_ACTION_OBJECT_DETAIL_TIMEOUT_SECONDS=900
OPENAI_ACTION_OBJECT_DETAIL_MAX_OUTPUT_TOKENS=8192

# =========================================
# UNIFIED ANALYSIS (Stage 3/4 provider)
# =========================================
UNIFIED_ANALYSIS_PROVIDER_ENABLED=false
UNIFIED_ANALYSIS_PROVIDER=openai
UNIFIED_ANALYSIS_MODEL=
UNIFIED_ANALYSIS_CODE_INTERPRETER_MEMORY=4g
# Profile-specific output budgets (GPT-4.1 analysis cap = 32768).
UNIFIED_ANALYSIS_ANALYSIS_MAX_OUTPUT_TOKENS=32768
UNIFIED_ANALYSIS_SMOKE_MAX_OUTPUT_TOKENS=2000
# Deprecated fallback when a profile-specific var is unset.
UNIFIED_ANALYSIS_MAX_OUTPUT_TOKENS=
# 1 initial attempt + (N-1) automatic in-run retries. Default 2 = one retry.
UNIFIED_ANALYSIS_PROVIDER_MAX_ATTEMPTS=2
UNIFIED_ANALYSIS_PROMPT_PROFILE=smoke
UNIFIED_ANALYSIS_PROMPT_VERSION=
UNIFIED_ANALYSIS_OUTPUT_VALIDATION_ENABLED=true
UNIFIED_ANALYSIS_POLL_INTERVAL_SECONDS=5
UNIFIED_ANALYSIS_MAX_POLL_DURATION_SECONDS=1800
UNIFIED_ANALYSIS_HTTP_TIMEOUT_SECONDS=60
UNIFIED_ANALYSIS_TRANSPORT_RETRIES=1
UNIFIED_ANALYSIS_CLEANUP_ENABLED=true
UNIFIED_ANALYSIS_DEBUG_ARTIFACTS=true

# Stage 5 publication rollout kill switches (all default off/safe; per-seller
# behavior is always the AND of these global flags and the seller's own
UNIFIED_ANALYSIS_ROLLOUT_ENABLED=false
UNIFIED_ANALYSIS_AUTO_RUN_ENABLED=false
UNIFIED_ANALYSIS_AUTO_PUBLISH_ENABLED=false
UNIFIED_ANALYSIS_LEGACY_FALLBACK_ENABLED=true

# =========================================
# UNIFIED AI PIPELINE
# =========================================
ALLOW_DEV_AI_PIPELINE=1
SELLER_AI_PIPELINE_ENABLED=1
ACTIONS_AI_FIRST=1
AI_PIPELINE_SHARED_CHUNK_ANALYSIS_ENABLED=true
LEGACY_AI_POST_SYNC_ENABLED=false

# =========================================
# AI REQUEST LIMITS
# =========================================
AI_MAX_INPUT_TOKENS_PER_REQUEST=120000
AI_MAX_INPUT_TOKENS_APPROX=120000

# Shared legacy/default limit.
# Stage-specific values above override this default.
AI_MAX_OUTPUT_TOKENS_PER_REQUEST=8192
AI_MAX_OUTPUT_TOKENS=4096

# =========================================
# AI HARDENING
# =========================================
AI_RECOMMENDATION_MAX_CONTEXT_ITEMS=50
AI_RECOMMENDATION_MAX_CONTEXT_BYTES=491520

AI_CHAT_MAX_CONTEXT_ITEMS=20
AI_CHAT_MAX_CONTEXT_BYTES=51200

AI_SUMMARY_MAX_CATEGORIES_PER_RUN=10
AI_CHAT_MAX_QUESTIONS_PER_DAY=50
AI_RECOMMENDATION_MAX_RUNS_PER_DAY=3
AI_SUMMARY_MAX_RUNS_PER_DAY=3

# =========================================
# CHAT ATTACHMENTS
# =========================================
CHAT_ATTACHMENT_MAX_FILE_BYTES=20971520
CHAT_ATTACHMENT_MAX_TOTAL_BYTES=31457280
CHAT_ATTACHMENT_MAX_FILES=5
CHAT_DRAFT_ATTACHMENT_TTL_HOURS=24
CHAT_OPENAI_FILE_TTL_HOURS=24
CHAT_ATTACHMENT_CLEANUP_ENABLED=true
CHAT_ATTACHMENT_CLEANUP_BATCH_SIZE=100

# =========================================
# MAINTENANCE
# =========================================
CLEANUP_ENABLED=false
CLEANUP_RETENTION_DAYS=90
CLEANUP_SCHEDULE=168h

DISCONNECTED_ACCOUNT_RETENTION_DAYS=90
DISCONNECTED_ACCOUNT_CLEANUP_ENABLED=false

# =========================================
# OZON / WORKER
# =========================================
OZON_PERFORMANCE_AUTH_URL=https://api-performance.ozon.ru
SYNC_INTERVAL=5m
WORKER_SCHEDULER_ENABLED=true
# Local default is 10; staging/production compose uses WORKER_CONCURRENCY=1.
WORKER_CONCURRENCY=10

# =========================================
# FRONTEND
# =========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=dev
