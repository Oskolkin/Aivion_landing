  "block_status_rules": {
    "blocks": [
      "account_diagnosis",
      "what_changed",
      "category_insights",
      "funnel_insight",
      "stock_insight",
      "advertising_insight",
      "seller_pulse_insight",
      "sku_focus_selection"
    ],
    "unavailable_when_no_data": true,
    "limited_when_partial_data": true
  },
  "section_domain_rules": {
    "account_diagnosis": { "allowed_scope_types": ["account"] },
    "what_changed": { "allowed_scope_types": ["account", "sku", "campaign", "category", "funnel"] },
    "category_insights": { "allowed_scope_types": ["category"] },
    "funnel_insight": { "allowed_scope_types": ["account", "funnel"] },
    "stock_insight": { "allowed_scope_types": ["account", "sku"] },
    "advertising_insight": { "allowed_scope_types": ["account", "campaign"] },
    "seller_pulse_insight": {
      "allowed_scope_types": ["account"],
      "forbidden_scope_types": ["campaign", "sku", "category"]
    },
    "sku_focus_selection": { "allowed_scope_types": ["sku"] }
  },
  "metric_rendering_rules": {
    "revenue_7d": { "render_format": "money", "delta_mode": "percent" },
    "orders_7d": { "render_format": "integer", "delta_mode": "percent" },
    "average_order_value_7d": { "render_format": "money", "delta_mode": "percent" },
    "impressions_7d": { "render_format": "integer", "delta_mode": "percent" },
    "impression_to_view_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "view_to_cart_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "cart_to_order_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "order_to_delivered_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "available_stock_units": { "render_format": "units", "delta_mode": "none" },
    "stock_coverage_days_7d": { "render_format": "days", "delta_mode": "absolute" },
    "stock_coverage_days_30d": { "render_format": "days", "delta_mode": "absolute" },
    "days_without_sales": { "render_format": "days", "delta_mode": "none" },
    "average_daily_sales_30d": { "render_format": "units", "delta_mode": "none" },
    "drr_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "campaign_drr_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "spend_7d": { "render_format": "money", "delta_mode": "percent" },
    "ad_spend_7d": { "render_format": "money", "delta_mode": "percent" },
    "ad_spend_share_of_total_revenue_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "ad_spend_share_of_total_store_revenue_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "ad_spend_share_of_attributed_revenue_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "revenue_share_pct": { "render_format": "percent", "delta_mode": "percentage_points" },
    "conversion_pct": { "render_format": "percent", "delta_mode": "percentage_points" }
  },
  "thresholds": [
    {
      "policy_id": "high_drr_campaign_threshold",
      "metric_code": "campaign_drr_pct",
      "operator": ">",
      "value": 80,
      "unit": "percent",
      "allowed_scope_types": ["campaign"]
    },
    {
      "policy_id": "low_stock_coverage_days_threshold",
      "metric_code": "stock_coverage_days_7d",
      "operator": "<",
      "value": 7,
      "unit": "days",
      "allowed_scope_types": ["sku"]
    }
  ],
  "completion_rules": {
    "target_must_be_unmet_at_analysis_time": true,
    "operator_direction": {
      "gt": "target_value_greater_than_baseline",
      "gte": "target_value_greater_than_baseline",
      "lt": "target_value_less_than_baseline",
      "lte": "target_value_less_than_baseline",
      "eq": "target_value_not_equal_baseline"
    }
  },
  "priority_constraints": {
    "min_required_execution_tier_count": 1,
    "severity_to_priority": {
      "critical": "critical",
      "important": "important",
      "watch": "watch",
      "none": "watch"
    }
  },
  "scope_rules": {
    "sku_single_action_ownership": true,
    "campaign_single_action_ownership": false,
    "account_scope_allows_empty_entity_ids": true,
    "sku_scope_requires_nonempty_entity_ids": true,
    "campaign_scope_requires_nonempty_entity_ids": true
  },
  "overlap_rules": {
    "sku_max_actions": 1,
    "finding_max_primary_block": 1,
    "dedupe_key": ["type", "goal", "sorted_entity_ids"]
  },
  "limitation_registry": [
    {
      "code": "sku_funnel_metrics_unavailable",
      "scope": "funnel",
      "severity": "watch",
      "description": "Per-SKU funnel metrics (impressions, views, add_to_cart) are not tracked; only account-level funnel data is available.",
      "affected_tables": ["sku_summary.csv", "sku_daily.csv"],
      "affected_blocks": ["funnel_insight", "sku_focus_selection"]
    },
    {
      "code": "sku_order_quality_unavailable",
      "scope": "sku",
      "severity": "watch",
      "description": "Per-SKU delivered/cancelled/returns breakdown is not tracked; only order count and revenue are available at SKU granularity.",
      "affected_tables": ["sku_summary.csv", "sku_daily.csv"],
      "affected_blocks": ["sku_focus_selection"]
    },
    {
      "code": "sku_reserved_stock_unknown",
      "scope": "stock",
      "severity": "watch",
      "description": "Reserved stock is not tracked as a distinct field; only available and in-transit stock are known.",
      "affected_tables": ["sku_summary.csv", "sku_daily.csv"],
      "affected_blocks": ["stock_insight", "sku_focus_selection"]
    },
    {
      "code": "sku_ad_spend_not_attributed",
      "scope": "advertising",
      "severity": "watch",
